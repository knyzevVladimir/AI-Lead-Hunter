# ============ AI Lead Hunter — environment ============
# Copy to .env and fill what you need. OpenStreetMap search works with NO keys.

# ---- App ----
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# ---- Database (docker-compose uses postgres; local dev defaults to sqlite) ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ailh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ailh

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Maps / business search (OSM needs no key) ----
GOOGLE_MAPS_API_KEY=
YANDEX_MAPS_API_KEY=
TWOGIS_API_KEY=

# ---- LLM (optional; offers/chat fall back to templates without it) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Ollama/vLLM set an OpenAI-compatible base URL, e.g. http://localhost:11434/v1
OPENAI_BASE_URL=

# ---- Email sending ----
DEFAULT_EMAIL_PROVIDER=smtp        # smtp | gmail | outlook
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false                 # true for port 465

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
MS_SENDER=
MS_APP_ONLY=false

# ---- CRM / Export ----
HUBSPOT_TOKEN=
AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=
BITRIX24_WEBHOOK_URL=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Shared Google OAuth (Google Sheets export)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Leads!A1

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api
API_INTERNAL_URL=http://backend:8000
