# ---------------------------------------------------------------------------
# Адрес бэкенда
# ---------------------------------------------------------------------------
# По умолчанию фронтенд обращается к same-origin прокси /api/backend/*,
# который Next перенаправляет на API_INTERNAL_URL. Это снимает вопрос CORS.
# Заполняйте NEXT_PUBLIC_API_URL только если браузер должен идти в бэкенд напрямую.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Адрес бэкенда для серверных rewrite'ов Next (внутри docker-сети — http://backend:8000)
API_INTERNAL_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Демо-режим
# ---------------------------------------------------------------------------
# 1 — интерфейс работает на встроенных фикстурах, без бэкенда.
# Нужен для разработки интерфейса, демонстраций и снятия скриншотов.
NEXT_PUBLIC_DEMO=0
